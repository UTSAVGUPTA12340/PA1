
<!DOCTYPE html>
<html>
<head>
<title>Tourist Places in India</title>

<style>
body {
    text-align: center;
    font-family: Arial;
}



h1 {
    color: blue;
}

.container {
    width: 80%;
    margin: auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
}

.place {
    border: 2px solid gray;
    padding: 10px;
}

img {
    width: 100%;
    height: 200px;
    object-fit: cover;
}

h2 {
    margin: 5px;
}
</style>
</head>

<body>

<h1>Tourist Places in India</h1>

<div class="container">

<div class="place">
<img src="https://commons.wikimedia.org/wiki/Special:FilePath/Delhi_India_Gate_Delhi.jpg" alt="India Gate">
<h2>India Gate</h2>
</div>

<div class="place">
<img src="https://commons.wikimedia.org/wiki/Special:FilePath/Red_Fort_Delhi_India.jpg" alt="Red Fort">
<h2>Red Fort</h2>
</div>

<div class="place">
<img src="https://commons.wikimedia.org/wiki/Special:FilePath/QUTUB_MINAR_DELHI_INDIA.jpg" alt="Qutub Minar">
<h2>Qutub Minar</h2>
</div>

<div class="place">
<img src="https://commons.wikimedia.org/wiki/Special:FilePath/Lotus_Temple_New_Delhi_India.jpg" alt="Lotus Temple">
<h2>Lotus Temple</h2>
</div>

</div>

</body>
</html>
