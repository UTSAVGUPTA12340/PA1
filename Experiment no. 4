<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hostel Room Booking Form</title>
</head>
<body>

    <h1 align="center">Hostel Room Booking Form</h1>
    <form action="#" method="Post" align="center">

    <!-- Name -->
     <label for="fullname">Full Name:</label>
     <input type="text" id="fullname" name="fullname" requied>
     <br><br>
     <!-- Email-->
      <label for="email">Email:</label>
      <input type="email" id="email" name="email" required>
      <br><br>
      <!-- Phone-->
       <label for="phone">Phone:</label>
       <input type="Phone" id="phone" name="phone" required>
       <br><br>

       <!--Date-->
       <label for="date"> check-in Date:</label>
       <input type="date" id="date" name="date" required>
       <br><br>

       <label for="date"> check-out date:</label>
       <input type="date" id="date" name="date" required>
       <br><br>
       <!--Room Type-->
       <label for="room-type">room types:</label>
       <select id="room-type" name="room-type">
        <option value="single">single room</option>
        <option value="double">double room</option>
        <option value="suite">suite</option>
       </select>
       <br><br>

       <!--Guests-->
       <label for="guests">Number of Guests:</label>
       <input type="number" id="guests" name="guests" min="1" required>
       <br><br>

       <!--special requests-->
       <label for="requests">Special Requests:</label>
       <textarea id="requests" name="requests"></textarea>
       <br><br>

       <!--button-group-->
       <button type="submit">Book Now</button>
       <button type="reset">Reset Form</button>
    
        

    </form>
    
</body>
</html>
